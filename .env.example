# Firebase Configuration Keys
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Firebase Console > Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ไม่บังคับ (ใช้กับ Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# เปิดปุ่มสลับบทบาททดสอบ (Owner/Admin/Tenant) ใน production build — ห้ามเปิดในระบบจริง
VITE_DEMO_MODE=false

# เบอร์ PromptPay ที่แสดงในหน้าจอง (ไม่ใส่ = ไม่แสดง)
VITE_PROMPTPAY_NUMBER=0965572213

# โดเมนอีเมลภายในสำหรับบัญชี owner/admin ที่ล็อกอินด้วยชื่อผู้ใช้ (ไม่ต้องรับอีเมลได้จริง)
VITE_STAFF_EMAIL_DOMAIN=staff.market-booking-project.web.app
