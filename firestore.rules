rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // role อ่านจาก users/{uid} เท่านั้น (ไม่เชื่อค่าจาก client)
    function userRole() {
      return isSignedIn() && exists(userPath()) ? get(userPath()).data.role : null;
    }

    function isAdmin() {
      return userRole() in ['admin', 'owner'];
    }

    function isOwner() {
      return userRole() == 'owner';
    }

    // ─── Markets (Layout Configuration) ──────────────────────────────────────
    // เอกสารผัง (ชื่อ, โซน, วัตถุ, ขนาด): ทุกคนอ่านได้ แก้ได้เฉพาะ owner/admin
    // แผงค้าแยกเป็น markets/{id}/stalls/{stallId} ผู้เช่าไม่มีสิทธิ์แก้เอกสารผังเลย
    match /markets/{marketId} {
      allow read: if true; // ลูกค้าและคนทั่วไปอ่านผังตลาดได้
      allow create, delete: if isAdmin();
      // ตั้งค่าตลาด (markets/{id}.settings): แก้ได้เฉพาะ admin ตรวจชนิดและจำนวนรอบ (ไม่เกิน 6)
      allow update: if isAdmin()
        && (!('settings' in request.resource.data)
            || (request.resource.data.settings is map
                && (!('rounds' in request.resource.data.settings)
                    || (request.resource.data.settings.rounds is list
                        && request.resource.data.settings.rounds.size() <= 6))));

      // แผงค้ารายแผง
      // - อ่าน: ทุกคน (ไม่มีข้อมูลส่วนบุคคล; bookedBy มี tenantId/bookedAt/bookingId + ชื่อร้าน/ประเภทสินค้า ไม่มีชื่อจริง/เบอร์โทร)
      // - สร้าง/ลบ/แก้ผัง (ตำแหน่ง ราคา สถานะ ฯลฯ): owner/admin เท่านั้น
      // - ผู้เช่าที่ล็อกอินจริง: จองแผงว่างเป็นชื่อตัวเองเท่านั้น (available -> booked)
      //   (available -> pending รอตรวจสลิป; booked ตั้งได้เฉพาะ admin หลังอนุมัติ)
      //   แก้ได้แค่ status/bookedBy/updatedAt จึงแก้ตำแหน่ง ราคา หรือแย่งแผงที่ถูกจองแล้วไม่ได้
      match /stalls/{stallId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isTenantBooking() || isTenantReleasing();
      }
    }

    // ─── Audit log helpers ───────────────────────────────────────────────────
    // การเปลี่ยนสถานะการจองต้องชี้ lastAuditId ไปยัง log ที่เขียนในคำสั่งเดียวกัน
    // (ผู้กระทำ/เวลา/เป้าหมาย/action ตรงกับการกระทำ) ไม่มี log = การกระทำไม่ผ่าน
    function auditLinked(bookingId, actions) {
      let id = request.resource.data.lastAuditId;
      return id is string
        && existsAfter(/databases/$(database)/documents/auditLogs/$(id))
        && getAfter(/databases/$(database)/documents/auditLogs/$(id)).data.targetType == 'booking'
        && getAfter(/databases/$(database)/documents/auditLogs/$(id)).data.targetId == bookingId
        && getAfter(/databases/$(database)/documents/auditLogs/$(id)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/auditLogs/$(id)).data.at == request.time
        && getAfter(/databases/$(database)/documents/auditLogs/$(id)).data.action in actions;
    }

    // update: ต้องเป็น log ใหม่ (ไม่ใช่ log เดิมของการกระทำก่อนหน้า) การจองเก่าที่ยังไม่มี lastAuditId ผ่านได้
    function auditNewFor(bookingId, actions) {
      return auditLinked(bookingId, actions)
        && (!('lastAuditId' in resource.data) || request.resource.data.lastAuditId != resource.data.lastAuditId);
    }

    // ลบการจอง: log id ตายตัว delete_{bookingId} เพราะ delete ส่ง lastAuditId ไม่ได้
    function auditDeleteOk(bookingId) {
      let p = /databases/$(database)/documents/auditLogs/$('delete_' + bookingId);
      return existsAfter(p)
        && getAfter(p).data.action == 'booking.delete'
        && getAfter(p).data.targetType == 'booking'
        && getAfter(p).data.targetId == bookingId
        && getAfter(p).data.actorUid == request.auth.uid
        && getAfter(p).data.at == request.time;
    }

    // ─── หมดเวลากันแผง (ไม่มี server: rules เป็นตัวตัดสินด้วย request.time) ────────────
    // การจองที่ยังไม่แนบสลิป (awaiting_slip) หรือถูกขอสลิปใหม่ (needs_slip แบบรายวัน/รอบ) กันแผงได้ holdMinutes นาที
    // เกินเวลาแล้วถือว่าแผงว่าง: คนอื่นจองทับได้ และเจ้าของส่งสลิปไม่ได้อีก
    function holdExpired(x) {
      return x.status in ['awaiting_slip', 'needs_slip']
        && 'holdStartedAt' in x && 'holdMinutes' in x
        && request.time > x.holdStartedAt + duration.value(x.holdMinutes, 'm');
    }

    function marketDocPath() {
      return /databases/$(database)/documents/markets/main-layout;
    }

    // เวลากันแผงรอสลิปต้องตรงกับตั้งค่าตลาด (ไม่ตั้ง = 30 นาที) ป้องกันผู้เช่าตั้งเวลายาวเอง
    function payHoldMinutesOk(m) {
      return m is int && m >= 10 && m <= 120
        && m == (exists(marketDocPath()) && 'settings' in get(marketDocPath()).data
                 && 'paymentHoldMinutes' in get(marketDocPath()).data.settings
                 ? get(marketDocPath()).data.settings.paymentHoldMinutes : 30);
    }

    // เวลาให้ส่งสลิปใหม่ (ชั่วโมง x 60) ตรงกับตั้งค่า (ไม่ตั้ง = 24 ชม.)
    function resubmitMinutesOk(m) {
      return m is int && m >= 60 && m <= 4320
        && m == (exists(marketDocPath()) && 'settings' in get(marketDocPath()).data
                 && 'resubmitHours' in get(marketDocPath()).data.settings
                 ? get(marketDocPath()).data.settings.resubmitHours * 60 : 1440);
    }

    // ผู้เช่ายกเลิกการจองที่ยังรอตรวจ: ปล่อยแผง pending ของตัวเองกลับเป็น available
    // ต้องยกเลิก booking ในคำสั่งเขียนเดียวกัน (getAfter) กันปล่อยแผงโดยที่ booking ยังอยู่
    function isTenantReleasing() {
      return isNotAnonymous()
        && resource.data.status == 'pending'
        && resource.data.bookedBy != null
        && resource.data.bookedBy.tenantId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedBy', 'updatedAt'])
        && request.resource.data.status == 'available'
        && request.resource.data.bookedBy == null
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookedBy.bookingId)).data.status == 'cancelled';
    }

    // ผู้เช่าจองแผง: ต้องเป็นแผงว่างและเปลี่ยนเป็น pending (รอตรวจสลิป) โดยระบุตัวเองเป็นผู้จองเท่านั้น
    function isTenantBooking() {
      return isNotAnonymous()
        && resource.data.status == 'available'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedBy', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.bookedBy.keys().hasOnly(['tenantId', 'bookedAt', 'bookingId', 'shopName', 'goodsType'])
        && request.resource.data.bookedBy.tenantId == request.auth.uid
        // สำเนาข้อมูลสาธารณะ (ชื่อร้าน/ประเภทสินค้า) เป็นข้อความสั้นเท่านั้น ห้ามใส่ข้อมูลส่วนตัว
        && (!('shopName' in request.resource.data.bookedBy)
            || (request.resource.data.bookedBy.shopName is string && request.resource.data.bookedBy.shopName.size() <= 60))
        && (!('goodsType' in request.resource.data.bookedBy)
            || (request.resource.data.bookedBy.goodsType is string && request.resource.data.bookedBy.goodsType.size() <= 60));
    }

    // ผู้เช่าส่งสลิปใหม่: needs_slip -> pending แก้ได้แค่ฟิลด์สลิป และต้องเขียนสลิปใหม่ในคำสั่งเดียวกัน
    function isTenantResubmit(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.status == 'needs_slip'
        && d.status == 'pending'
        && d.diff(r).affectedKeys().hasOnly(['status', 'statusReason', 'slipHash', 'slipUploadedAt', 'updatedAt', 'lastAuditId'])
        && auditNewFor(bookingId, ['booking.slip_submit'])
        && !('statusReason' in d)
        && d.slipHash is string
        && d.slipUploadedAt == request.time
        && d.updatedAt == request.time
        && !holdExpired(r)
        && getAfter(/databases/$(database)/documents/bookingSlips/$(bookingId)).data.createdAt == request.time;
    }

    // ผู้เช่าแนบสลิปครั้งแรกหลังกันแผง: awaiting_slip -> pending ต้องยังไม่หมดเวลา และเขียนสลิปในคำสั่งเดียวกัน
    function isTenantPaySlip(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.status == 'awaiting_slip'
        && d.status == 'pending'
        && d.diff(r).affectedKeys().hasOnly(['status', 'slipHash', 'slipUploadedAt', 'updatedAt', 'lastAuditId'])
        && auditNewFor(bookingId, ['booking.slip_submit'])
        && d.slipHash is string
        && d.slipUploadedAt == request.time
        && d.updatedAt == request.time
        && !holdExpired(r)
        && getAfter(/databases/$(database)/documents/bookingSlips/$(bookingId)).data.createdAt == request.time;
    }

    // ตั้งสถานะ "หมดเวลา": เจ้าของหรือ admin ทำได้เมื่อหมดเวลากันแผงแล้วเท่านั้น (แก้ได้เฉพาะสถานะ)
    function isExpireBooking(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && (r.tenantId == request.auth.uid || isAdmin())
        && holdExpired(r)
        && d.status == 'expired'
        && d.diff(r).affectedKeys().hasOnly(['status', 'updatedAt', 'lastAuditId'])
        && auditNewFor(bookingId, ['booking.expire'])
        && d.updatedAt == request.time;
    }

    // ผู้เช่ายกเลิกเอง: awaiting_slip / pending / needs_slip และแผงต้องถูกปล่อยพร้อมกัน
    // ยกเลิกตอน pending (ส่งสลิปแล้ว) ตั้ง refund = { status: 'pending' } ให้ admin ตรวจว่าต้องคืนเงินไหม
    function isTenantCancel(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.status in ['awaiting_slip', 'pending', 'needs_slip']
        && d.status == 'cancelled'
        && d.diff(r).affectedKeys().hasOnly(['status', 'updatedAt', 'lastAuditId', 'refund'])
        && (!('refund' in d.diff(r).affectedKeys()) || (r.status == 'pending' && d.refund == {'status': 'pending'}))
        && auditNewFor(bookingId, ['booking.cancel_self'])
        && d.updatedAt == request.time
        && ('slots' in r || getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(r.stallId)).data.status == 'available');
    }

    // ผู้เช่าขอยกเลิกการจองที่อนุมัติแล้ว: approved -> cancel_requested (แผงยังเป็นของผู้เช่าจนกว่า admin อนุมัติ)
    function isTenantCancelRequest(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.get('status', '') == 'approved'
        && d.status == 'cancel_requested'
        && d.diff(r).affectedKeys().hasOnly(['status', 'cancelRequest', 'updatedAt', 'lastAuditId'])
        && d.cancelRequest.keys().hasOnly(['reason', 'requestedAt'])
        && d.cancelRequest.reason is string && d.cancelRequest.reason.size() >= 1 && d.cancelRequest.reason.size() <= 300
        && d.cancelRequest.requestedAt == request.time
        && auditNewFor(bookingId, ['booking.cancel_request'])
        && d.updatedAt == request.time;
    }

    // ผู้เช่าถอนคำขอยกเลิก: cancel_requested -> approved
    function isTenantWithdrawCancel(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.status == 'cancel_requested'
        && d.status == 'approved'
        && d.diff(r).affectedKeys().hasOnly(['status', 'cancelRequest', 'updatedAt', 'lastAuditId'])
        && !('cancelRequest' in d)
        && auditNewFor(bookingId, ['booking.cancel_withdraw'])
        && d.updatedAt == request.time;
    }

    // เลขใบเสร็จ: เรียงต่อกันด้วย counters/receipts_{ปี พ.ศ.} ที่เพิ่มทีละ 1 ในคำสั่งเดียวกัน ตั้งได้ครั้งเดียว
    function receiptCounterPath(year) {
      return /databases/$(database)/documents/counters/$('receipts_' + string(year));
    }

    function receiptValid(d) {
      return d.receiptYear is int && d.receiptYear >= 2560 && d.receiptYear <= 2700
        && d.receiptSeq is int && d.receiptSeq >= 1
        && d.receiptNo is string
        && d.receiptNo.matches('^R[0-9]{4}-[0-9]{6}$')
        && d.receiptNo.split('-')[0] == 'R' + string(d.receiptYear)
        && int(d.receiptNo.split('-')[1]) == d.receiptSeq
        && d.receiptIssuedAt == request.time
        && getAfter(receiptCounterPath(d.receiptYear)).data.next == d.receiptSeq
        && (exists(receiptCounterPath(d.receiptYear))
            ? get(receiptCounterPath(d.receiptYear)).data.next + 1 == d.receiptSeq
            : d.receiptSeq == 1);
    }

    // ออกเลขใบเสร็จให้การจองเก่าที่อนุมัติไปก่อนมีระบบนี้ (admin เท่านั้น ตั้งได้ครั้งเดียว)
    function isReceiptIssue(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isAdmin()
        && (r.status == 'approved' || (r.status == 'cancelled' && r.get('wasApproved', false) == true) || !('status' in r))
        && !('receiptNo' in r)
        && d.diff(r).affectedKeys().hasOnly(['receiptNo', 'receiptSeq', 'receiptYear', 'receiptIssuedAt', 'updatedAt', 'lastAuditId'])
        && receiptValid(d)
        && auditNewFor(bookingId, ['booking.receipt_issue'])
        && d.updatedAt == request.time;
    }

    function refundShapeOk(rf, r) {
      return rf is map
        && rf.keys().hasOnly(['status', 'amount', 'suggestedAmount', 'policyText', 'adjustReason'])
        && rf.status in ['pending', 'none']
        && rf.amount is number && rf.amount >= 0 && rf.amount <= r.amountDue
        && (rf.status == 'pending' || rf.amount == 0)
        && (!('suggestedAmount' in rf) || (rf.suggestedAmount is number && rf.suggestedAmount >= 0 && rf.suggestedAmount <= r.amountDue))
        && (!('policyText' in rf) || (rf.policyText is string && rf.policyText.size() <= 300))
        && ((!('suggestedAmount' in rf) || rf.suggestedAmount == rf.amount)
            || (rf.get('adjustReason', '') is string && rf.get('adjustReason', '').size() >= 1 && rf.get('adjustReason', '').size() <= 300));
    }

    // admin/owner จัดการคำขอยกเลิก / ยกเลิกการจองที่อนุมัติแล้วเอง
    //  cancel_requested -> cancelled (cancel_approve) | -> approved (cancel_deny, ต้องมีเหตุผล)
    //  approved -> cancelled (cancel_admin, ต้องมีเหตุผล)
    function isAdminCancelDecision(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isAdmin()
        && 'status' in r
        && ((r.status == 'cancel_requested' && d.status in ['cancelled', 'approved'])
            || (r.status == 'approved' && d.status == 'cancelled'))
        && d.diff(r).affectedKeys().hasOnly(['status', 'statusReason', 'refund', 'cancelRequest', 'releasedSlots',
             'wasApproved', 'decidedBy', 'decidedAt', 'updatedAt', 'lastAuditId'])
        && auditNewFor(bookingId, [r.status == 'approved' ? 'booking.cancel_admin'
             : (d.status == 'cancelled' ? 'booking.cancel_approve' : 'booking.cancel_deny')])
        && d.decidedBy == request.auth.uid
        && d.decidedAt == request.time
        && d.updatedAt == request.time
        && (d.status == 'approved'
            ? (d.statusReason is string && d.statusReason.size() >= 1 && d.statusReason.size() <= 300 && !('cancelRequest' in d))
            : (d.wasApproved == true
               && refundShapeOk(d.refund, r)
               && (r.status == 'cancel_requested'
                   || (d.statusReason is string && d.statusReason.size() >= 1 && d.statusReason.size() <= 300))
               && (!('releasedSlots' in d)
                   || ('slots' in r && d.releasedSlots is list && d.releasedSlots.size() <= 7 && r.slots.hasAll(d.releasedSlots)))));
    }

    // admin/owner บันทึกว่าคืนเงินแล้ว: refund.status pending -> refunded (ยอดไม่เกินยอดที่จ่าย)
    function isRefundRecord(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isAdmin()
        && r.status == 'cancelled'
        && 'refund' in r && r.refund.status == 'pending'
        && d.status == 'cancelled'
        && d.diff(r).affectedKeys().hasOnly(['refund', 'updatedAt', 'lastAuditId'])
        && d.refund.keys().hasOnly(['status', 'amount', 'suggestedAmount', 'policyText', 'adjustReason',
             'method', 'refundedDate', 'note', 'refundedBy', 'refundedAt'])
        && d.refund.status == 'refunded'
        && d.refund.amount is number && d.refund.amount >= 0 && d.refund.amount <= r.amountDue
        && d.refund.method in ['transfer', 'promptpay', 'cash']
        && d.refund.refundedDate is string && d.refund.refundedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('note' in d.refund) || (d.refund.note is string && d.refund.note.size() <= 300))
        && d.refund.refundedBy == request.auth.uid
        && d.refund.refundedAt == request.time
        && auditNewFor(bookingId, ['refund.record'])
        && d.updatedAt == request.time;
    }

    function isValidDecision(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      let stallPath = /databases/$(database)/documents/markets/main-layout/stalls/$(r.stallId);
      return (r.status == 'pending' || (r.status == 'needs_slip' && d.status == 'rejected'))
        && d.status in ['approved', 'needs_slip', 'rejected']
        && d.diff(r).affectedKeys().hasOnly(['status', 'statusReason', 'decidedBy', 'decidedAt', 'updatedAt', 'lastAuditId',
             'holdStartedAt', 'holdMinutes', 'receiptNo', 'receiptSeq', 'receiptYear', 'receiptIssuedAt'])
        && auditNewFor(bookingId, [d.status == 'approved' ? 'booking.approve' : (d.status == 'rejected' ? 'booking.reject' : 'booking.request_slip')])
        && d.decidedBy == request.auth.uid
        && d.decidedAt == request.time
        && (d.status == 'approved'
            || (d.statusReason is string && d.statusReason.size() >= 1 && d.statusReason.size() <= 300))
        // ขอสลิปใหม่ของการจองรายวัน/รอบ: ตั้งเวลานับถอยหลังใหม่ (หมดเวลาแล้วช่องกลับว่าง)
        && (!('holdStartedAt' in d.diff(r).affectedKeys()) || ('slots' in r && d.status == 'needs_slip'
             && d.holdStartedAt == request.time && resubmitMinutesOk(d.holdMinutes)))
        // ใบเสร็จออกตอนอนุมัติ (ไม่บังคับ เพื่อให้หน้าเว็บเวอร์ชันเก่ายังอนุมัติได้)
        && (!('receiptNo' in d.diff(r).affectedKeys()) || (d.status == 'approved' && !('receiptNo' in r) && receiptValid(d)))
        && ('slots' in r || getAfter(stallPath).data.status == (d.status == 'approved' ? 'booked' : (d.status == 'rejected' ? 'available' : 'pending')));
    }

    // ─── การจองแบบเดิม (กันแผงด้วย stall.status ไม่มีวันที่) ─────────────────────
    function legacyBookingCreate(bookingId) {
      return getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.bookedBy.tenantId == request.auth.uid
        && getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.bookedBy.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.status == 'pending'
        // การจองใหม่ต้องรอตรวจสลิป ยอดต้องตรงราคาแผงจริง และต้องแนบสลิปในคำสั่งเขียนเดียวกัน
        && request.resource.data.status == 'pending'
        && request.resource.data.amountDue == getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.price
        && request.resource.data.createdAt == request.time
        && request.resource.data.slipUploadedAt == request.time
        && request.resource.data.slipHash is string
        && request.resource.data.keys().hasOnly(['stallId', 'stallNo', 'tenantId', 'customerName', 'customerPhone',
             'shopName', 'goodsType', 'amountDue', 'slipHash', 'slipUploadedAt', 'createdAt', 'status', 'lastAuditId'])
        && auditLinked(bookingId, ['booking.create'])
        && existsAfter(/databases/$(database)/documents/bookingSlips/$(bookingId));
    }

    // ─── การจองตามวัน/รอบ (slot) ─────────────────────────────────────────────
    // booking + bookingLocks ทุก slot + สลิป + audit log ต้องอยู่ในคำสั่งเขียนเดียวกัน
    // ปฏิทินตลาด (วันเปิด/ปิด จองล่วงหน้า เวลาปิดรับ) ตรวจที่ client ไม่ได้อยู่ใน rules
    function slotLockPath(stallId, slotKey) {
      return /databases/$(database)/documents/bookingLocks/$(stallId + '_' + slotKey);
    }

    // lock ของ slot ลำดับที่ i ต้องมีอยู่ และชี้มาที่การจองนี้
    function slotLockOk(d, bookingId, i) {
      return d.slots.size() <= i
        || getAfter(slotLockPath(d.stallId, d.slots[i])).data.bookingId == bookingId;
    }

    // สร้างได้ 2 แบบ: pending (แนบสลิปมาด้วย) หรือ awaiting_slip (กันแผงไว้ก่อน ส่งสลิปทีหลังภายใน holdMinutes)
    function slotBookingCreate(bookingId) {
      let d = request.resource.data;
      let stall = get(/databases/$(database)/documents/markets/main-layout/stalls/$(d.stallId)).data;
      return d.slots is list
        && d.slots.size() >= 1 && d.slots.size() <= 7
        && d.slots.toSet().size() == d.slots.size()
        && stall.status == 'available'
        && d.pricePerSlot == stall.price
        && d.totalAmount == d.pricePerSlot * d.slots.size()
        && d.amountDue == d.totalAmount
        && d.firstDate == d.slots[0].split('_')[0]
        && d.lastDate == d.slots[d.slots.size() - 1].split('_')[0]
        && d.status in ['pending', 'awaiting_slip']
        && d.createdAt == request.time
        && d.keys().hasOnly(['stallId', 'stallNo', 'tenantId', 'customerName', 'customerPhone', 'shopName', 'goodsType',
             'slots', 'firstDate', 'lastDate', 'pricePerSlot', 'totalAmount', 'amountDue',
             'slipHash', 'slipUploadedAt', 'createdAt', 'status', 'lastAuditId', 'holdStartedAt', 'holdMinutes'])
        && (d.status == 'pending'
            ? (d.slipUploadedAt == request.time
               && d.slipHash is string
               && !('holdStartedAt' in d) && !('holdMinutes' in d)
               && existsAfter(/databases/$(database)/documents/bookingSlips/$(bookingId)))
            : (d.holdStartedAt == request.time
               && payHoldMinutesOk(d.holdMinutes)
               && !('slipHash' in d) && !('slipUploadedAt' in d)))
        && auditLinked(bookingId, ['booking.create'])
        && slotLockOk(d, bookingId, 0) && slotLockOk(d, bookingId, 1) && slotLockOk(d, bookingId, 2)
        && slotLockOk(d, bookingId, 3) && slotLockOk(d, bookingId, 4) && slotLockOk(d, bookingId, 5)
        && slotLockOk(d, bookingId, 6);
    }

    // ─── Bookings (Customer Transaction History) ─────────────────────────────
    // มีชื่อ/เบอร์โทร -> อ่านได้เฉพาะเจ้าของรายการและ admin
    // สร้างได้ต่อเมื่อแผงนั้นถูกจองในชื่อตัวเองในคำสั่งเขียนเดียวกัน (transaction) กันสร้างรายการปลอม
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isNotAnonymous()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.stallId is string
        && ('slots' in request.resource.data ? slotBookingCreate(bookingId) : legacyBookingCreate(bookingId));
      // admin/owner ตัดสินได้เฉพาะ pending -> approved / needs_slip / rejected (และ needs_slip -> rejected)
      // แก้ได้แค่ฟิลด์ผลการตรวจ ห้ามแก้ยอด/ผู้เช่า/สลิป และสถานะแผงต้องเปลี่ยนตามผลในคำสั่งเดียวกัน
      allow update: if (isAdmin() && isValidDecision(bookingId))
        || isTenantResubmit(bookingId)
        || isTenantPaySlip(bookingId)
        || isTenantCancel(bookingId)
        || isExpireBooking(bookingId)
        || isTenantCancelRequest(bookingId)
        || isTenantWithdrawCancel(bookingId)
        || isAdminCancelDecision(bookingId)
        || isRefundRecord(bookingId)
        || isReceiptIssue(bookingId);
      // ลบถาวร: admin/owner เท่านั้น เฉพาะสถานะที่ตัดสินจบแล้ว (การจองเก่าที่ไม่มี status นับเป็น approved)
      // ห้ามลบเมื่อมียอดรอคืนเงิน; ออกเลขใบเสร็จแล้วลบได้เฉพาะ owner; ต้องมี audit log
      // auditLogs/delete_{bookingId} (action booking.delete) เขียนในคำสั่งเดียวกัน
      allow delete: if isAdmin()
        && (!('status' in resource.data) || resource.data.status in ['approved', 'rejected', 'cancelled', 'expired'])
        && !(resource.data.get('refund', {}).get('status', '') == 'pending')
        && (!('receiptNo' in resource.data) || isOwner())
        && auditDeleteOk(bookingId);
    }

    // ─── Booking Locks (กันจองซ้ำรายวัน/รอบ) ─────────────────────────────────
    // id = {stallId}_{slotKey} สร้างได้อย่างเดียว (มีแล้วสร้างซ้ำไม่ได้ = จองซ้ำไม่ได้)
    // ไม่มีข้อมูลส่วนตัว (มีแค่ชื่อร้าน/ประเภทสินค้าที่ผู้จองเปิดเผยให้ลูกค้าอื่นเห็น) อ่านได้ทุกคน
    // เปลี่ยนสถานะ/ลบ: admin; ผู้เช่าลบได้เฉพาะตอนยกเลิกการจองของตัวเองในคำสั่งเดียวกัน
    // lock ใหม่: status ตรงกับสถานะการจองในคำสั่งเดียวกัน (pending = แนบสลิปแล้ว | awaiting_slip = กันแผงรอสลิป)
    function lockShapeOk(lockId, l) {
      let bk = getAfter(/databases/$(database)/documents/bookings/$(l.bookingId)).data;
      return l.keys().hasOnly(['marketId', 'stallId', 'date', 'roundId', 'slotKey', 'bookingId',
             'status', 'shopName', 'goodsType', 'createdAt', 'holdStartedAt', 'holdMinutes'])
        && l.keys().hasAll(['marketId', 'stallId', 'date', 'roundId', 'slotKey', 'bookingId', 'status', 'createdAt'])
        && l.status in ['pending', 'awaiting_slip']
        && l.status == bk.status
        && (l.status == 'pending'
            ? (!('holdStartedAt' in l) && !('holdMinutes' in l))
            : (l.holdStartedAt == request.time && l.holdMinutes == bk.holdMinutes && l.holdMinutes is int))
        && l.slotKey is string
        && l.slotKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]{1,20}$')
        && l.slotKey == l.date + '_' + l.roundId
        && lockId == l.stallId + '_' + l.slotKey
        && l.createdAt == request.time
        && (!('shopName' in l) || (l.shopName is string && l.shopName.size() <= 60))
        && (!('goodsType' in l) || (l.goodsType is string && l.goodsType.size() <= 60))
        && get(/databases/$(database)/documents/markets/main-layout/stalls/$(l.stallId)).data.status == 'available'
        && bk.tenantId == request.auth.uid
        && bk.stallId == l.stallId
        && l.slotKey in bk.slots;
    }

    // ผู้เช่าส่งสลิปแล้ว: lock ของตัวเองจาก awaiting_slip / needs_slip กลับเป็น pending (พร้อม booking -> pending)
    function lockFlipToPending() {
      return isNotAnonymous()
        && resource.data.status in ['awaiting_slip', 'needs_slip']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.tenantId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'pending';
    }

    match /bookingLocks/{lockId} {
      allow read: if true;
      allow create: if isNotAnonymous() && lockShapeOk(lockId, request.resource.data);
      // admin เปลี่ยนสถานะได้; จองทับ lock ที่หมดเวลาแล้ว (เขียนทับด้วย lock ใหม่ที่ถูกต้องครบ); ผู้เช่าส่งสลิปแล้วพลิกเป็น pending
      allow update: if isAdmin()
        || (isNotAnonymous() && holdExpired(resource.data) && lockShapeOk(lockId, request.resource.data))
        || lockFlipToPending();
      // ลบ: admin | เจ้าของเมื่อยกเลิกการจองของตัวเอง | เจ้าของเมื่อการจองหมดเวลาแล้ว (lock หมดอายุจริง)
      allow delete: if isAdmin()
        || (isNotAnonymous()
            && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.tenantId == request.auth.uid
            && (getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'cancelled'
                || (getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'expired'
                    && holdExpired(resource.data))));
    }

    // ─── Booking Slips (รูปสลิป แยกจาก bookings เพื่อไม่ให้รายการจองหนัก) ───────
    // อ่านได้เฉพาะเจ้าของและ admin; สร้างได้พร้อมการจองของตัวเองเท่านั้น; ลบ: admin
    match /bookingSlips/{bookingId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isNotAnonymous()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'marketId', 'dataUrl', 'mime', 'bytes', 'createdAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 750000
        && request.resource.data.dataUrl.matches('^data:image/(webp|jpeg);base64,.*')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.tenantId == request.auth.uid;
      // ส่งสลิปใหม่: เจ้าของแก้รูปได้เฉพาะตอน booking เป็น needs_slip และกลับเป็น pending ในคำสั่งเดียวกัน
      allow update: if isNotAnonymous()
        && resource.data.tenantId == request.auth.uid
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'marketId', 'dataUrl', 'mime', 'bytes', 'createdAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 750000
        && request.resource.data.dataUrl.matches('^data:image/(webp|jpeg);base64,.*')
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'needs_slip'
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'pending';
      // ตอนอนุมัติ: admin ตั้งเวลาลบรูปอัตโนมัติ (purgeAfter) ได้อย่างเดียว พร้อม booking เป็น approved
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purgeAfter'])
        && request.resource.data.purgeAfter is timestamp
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'approved';
      allow delete: if isAdmin();
    }

    // ─── Audit Logs (บันทึกการทำงาน) ─────────────────────────────────────────
    // สร้างได้อย่างเดียว แก้/ลบไม่ได้ (แม้เป็น owner) อ่านได้เฉพาะ admin/owner
    // ผู้เช่าเขียนได้เฉพาะ action ของผู้เช่าและเฉพาะการจองของตัวเอง role ต้องตรงกับ users/{uid}
    // หมายเหตุ: owner ที่เข้า Firebase Console ยังลบได้ (กันไม่ได้บน Spark)
    function auditAdminActions() {
      return ['booking.create', 'booking.slip_submit', 'booking.approve', 'booking.request_slip', 'booking.reject',
              'booking.cancel_self', 'booking.cancel_request', 'booking.cancel_approve', 'booking.cancel_deny',
              'booking.cancel_admin', 'booking.expire', 'refund.record', 'settings.update', 'stall.close',
              'stall.open', 'user.role_change', 'legacy.end', 'booking.delete', 'booking.cancel_withdraw',
              'booking.receipt_issue', 'report.export', 'auditlog.purge'];
    }

    function auditTenantActions() {
      return ['booking.create', 'booking.slip_submit', 'booking.cancel_self', 'booking.cancel_request',
              'booking.cancel_withdraw', 'booking.expire'];
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow update: if false;
      // ลบได้เฉพาะ owner (ปุ่มลบในหน้าบันทึกการทำงาน) ส่วน admin ลบไม่ได้
      allow delete: if isOwner();
      allow create: if isNotAnonymous()
        && request.resource.data.keys().hasOnly(['at', 'actorUid', 'actorName', 'actorRole', 'action', 'targetType',
             'targetId', 'marketId', 'before', 'after', 'reason', 'bookingId'])
        && request.resource.data.keys().hasAll(['at', 'actorUid', 'actorRole', 'action', 'targetType', 'targetId'])
        && request.resource.data.at == request.time
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetType in ['booking', 'stall', 'settings', 'user', 'refund']
        && request.resource.data.targetId is string
        && (!('actorName' in request.resource.data)
            || (request.resource.data.actorName is string && request.resource.data.actorName.size() <= 100))
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string && request.resource.data.reason.size() <= 300))
        && (!('before' in request.resource.data) || request.resource.data.before is map)
        && (!('after' in request.resource.data) || request.resource.data.after is map)
        && (!('bookingId' in request.resource.data) || request.resource.data.bookingId is string)
        && (isAdmin()
            ? (request.resource.data.actorRole == userRole()
               && request.resource.data.action in auditAdminActions())
            : (request.resource.data.actorRole == 'tenant'
               && request.resource.data.action in auditTenantActions()
               && request.resource.data.targetType == 'booking'
               && request.resource.data.bookingId == request.resource.data.targetId
               && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.tenantId == request.auth.uid));
    }

    // ─── Counters (เลขใบเสร็จ) ───────────────────────────────────────────────
    // counters/receipts_{ปี พ.ศ.} { year, next } เพิ่มทีละ 1 เท่านั้น (admin) ข้ามเลข/ลดเลขไม่ได้
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && counterId.matches('^receipts_[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['year', 'next'])
        && request.resource.data.next == 1
        && counterId == 'receipts_' + string(request.resource.data.year);
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['year', 'next'])
        && request.resource.data.year == resource.data.year
        && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // ─── บัญชีรับเงินคืน (แยกจาก booking ไม่ให้ไปโผล่ในรายการ/รายงาน) ─────────────
    match /refundAccounts/{bookingId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create, update: if isNotAnonymous()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'accountName', 'bank', 'accountNo'])
        && request.resource.data.accountName is string && request.resource.data.accountName.size() <= 100
        && request.resource.data.bank is string && request.resource.data.bank.size() <= 60
        && request.resource.data.accountNo is string && request.resource.data.accountNo.size() <= 40
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.tenantId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'cancel_requested';
      allow delete: if isAdmin();
    }

    // ─── สลิปคืนเงิน (admin อัปโหลด เจ้าของการจองดูได้) ─────────────────────────
    match /refundSlips/{bookingId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['tenantId', 'marketId', 'dataUrl', 'mime', 'bytes', 'createdAt'])
        && request.resource.data.tenantId == get(/databases/$(database)/documents/bookings/$(bookingId)).data.tenantId
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 750000
        && request.resource.data.dataUrl.matches('^data:image/(webp|jpeg);base64,.*')
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // สมัครได้เฉพาะ document ของตัวเอง และเป็น tenant เท่านั้น
      allow create: if isNotAnonymous()
        && request.auth.uid == userId
        && request.resource.data.role == 'tenant';

      // เจ้าของแก้ข้อมูลตัวเองได้ แต่ห้ามเปลี่ยน role / Owner เปลี่ยนได้ทุกอย่าง
      allow update: if isOwner()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role);

      allow delete: if isOwner();
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn()
        && (resource.data.tenantId == request.auth.uid || isAdmin());

      // ผู้เช่าทำได้แค่กด "อ่านแล้ว"
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.tenantId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));

      // แจ้งเตือนถูกสร้างตอน admin บันทึกผังเท่านั้น
      allow create: if isAdmin();
    }
  }
}
