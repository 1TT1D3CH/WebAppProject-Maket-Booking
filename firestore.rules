rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // role อ่านจาก users/{uid} เท่านั้น (ไม่เชื่อค่าจาก client)
    function userRole() {
      return isSignedIn() && exists(userPath()) ? get(userPath()).data.role : null;
    }

    function isAdmin() {
      return userRole() in ['admin', 'owner'];
    }

    function isOwner() {
      return userRole() == 'owner';
    }

    // ─── Markets (Layout Configuration) ──────────────────────────────────────
    // เอกสารผัง (ชื่อ, โซน, วัตถุ, ขนาด): ทุกคนอ่านได้ แก้ได้เฉพาะ owner/admin
    // แผงค้าแยกเป็น markets/{id}/stalls/{stallId} ผู้เช่าไม่มีสิทธิ์แก้เอกสารผังเลย
    match /markets/{marketId} {
      allow read: if true; // ลูกค้าและคนทั่วไปอ่านผังตลาดได้
      allow create, update, delete: if isAdmin();

      // แผงค้ารายแผง
      // - อ่าน: ทุกคน (ไม่มีข้อมูลส่วนบุคคล; bookedBy มี tenantId/bookedAt/bookingId + ชื่อร้าน/ประเภทสินค้า ไม่มีชื่อจริง/เบอร์โทร)
      // - สร้าง/ลบ/แก้ผัง (ตำแหน่ง ราคา สถานะ ฯลฯ): owner/admin เท่านั้น
      // - ผู้เช่าที่ล็อกอินจริง: จองแผงว่างเป็นชื่อตัวเองเท่านั้น (available -> booked)
      //   (available -> pending รอตรวจสลิป; booked ตั้งได้เฉพาะ admin หลังอนุมัติ)
      //   แก้ได้แค่ status/bookedBy/updatedAt จึงแก้ตำแหน่ง ราคา หรือแย่งแผงที่ถูกจองแล้วไม่ได้
      match /stalls/{stallId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isTenantBooking() || isTenantReleasing();
      }
    }

    // ผู้เช่ายกเลิกการจองที่ยังรอตรวจ: ปล่อยแผง pending ของตัวเองกลับเป็น available
    // ต้องยกเลิก booking ในคำสั่งเขียนเดียวกัน (getAfter) กันปล่อยแผงโดยที่ booking ยังอยู่
    function isTenantReleasing() {
      return isNotAnonymous()
        && resource.data.status == 'pending'
        && resource.data.bookedBy != null
        && resource.data.bookedBy.tenantId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedBy', 'updatedAt'])
        && request.resource.data.status == 'available'
        && request.resource.data.bookedBy == null
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookedBy.bookingId)).data.status == 'cancelled';
    }

    // ผู้เช่าจองแผง: ต้องเป็นแผงว่างและเปลี่ยนเป็น pending (รอตรวจสลิป) โดยระบุตัวเองเป็นผู้จองเท่านั้น
    function isTenantBooking() {
      return isNotAnonymous()
        && resource.data.status == 'available'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedBy', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.bookedBy.keys().hasOnly(['tenantId', 'bookedAt', 'bookingId', 'shopName', 'goodsType'])
        && request.resource.data.bookedBy.tenantId == request.auth.uid
        // สำเนาข้อมูลสาธารณะ (ชื่อร้าน/ประเภทสินค้า) เป็นข้อความสั้นเท่านั้น ห้ามใส่ข้อมูลส่วนตัว
        && (!('shopName' in request.resource.data.bookedBy)
            || (request.resource.data.bookedBy.shopName is string && request.resource.data.bookedBy.shopName.size() <= 60))
        && (!('goodsType' in request.resource.data.bookedBy)
            || (request.resource.data.bookedBy.goodsType is string && request.resource.data.bookedBy.goodsType.size() <= 60));
    }

    // ผู้เช่าส่งสลิปใหม่: needs_slip -> pending แก้ได้แค่ฟิลด์สลิป และต้องเขียนสลิปใหม่ในคำสั่งเดียวกัน
    function isTenantResubmit(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.status == 'needs_slip'
        && d.status == 'pending'
        && d.diff(r).affectedKeys().hasOnly(['status', 'statusReason', 'slipHash', 'slipUploadedAt', 'updatedAt'])
        && !('statusReason' in d)
        && d.slipHash is string
        && d.slipUploadedAt == request.time
        && d.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/bookingSlips/$(bookingId)).data.createdAt == request.time;
    }

    // ผู้เช่ายกเลิกเอง: เฉพาะ pending / needs_slip และแผงต้องถูกปล่อยพร้อมกัน
    function isTenantCancel() {
      let d = request.resource.data;
      let r = resource.data;
      return isNotAnonymous()
        && r.tenantId == request.auth.uid
        && r.status in ['pending', 'needs_slip']
        && d.status == 'cancelled'
        && d.diff(r).affectedKeys().hasOnly(['status', 'updatedAt'])
        && d.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(r.stallId)).data.status == 'available';
    }

    function isValidDecision(bookingId) {
      let d = request.resource.data;
      let r = resource.data;
      let stallPath = /databases/$(database)/documents/markets/main-layout/stalls/$(r.stallId);
      return (r.status == 'pending' || (r.status == 'needs_slip' && d.status == 'rejected'))
        && d.status in ['approved', 'needs_slip', 'rejected']
        && d.diff(r).affectedKeys().hasOnly(['status', 'statusReason', 'decidedBy', 'decidedAt', 'updatedAt'])
        && d.decidedBy == request.auth.uid
        && d.decidedAt == request.time
        && (d.status == 'approved'
            || (d.statusReason is string && d.statusReason.size() >= 1 && d.statusReason.size() <= 300))
        && getAfter(stallPath).data.status == (d.status == 'approved' ? 'booked' : (d.status == 'rejected' ? 'available' : 'pending'));
    }

    // ─── Bookings (Customer Transaction History) ─────────────────────────────
    // มีชื่อ/เบอร์โทร -> อ่านได้เฉพาะเจ้าของรายการและ admin
    // สร้างได้ต่อเมื่อแผงนั้นถูกจองในชื่อตัวเองในคำสั่งเขียนเดียวกัน (transaction) กันสร้างรายการปลอม
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isNotAnonymous()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.stallId is string
        && getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.bookedBy.tenantId == request.auth.uid
        && getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.bookedBy.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.status == 'pending'
        // การจองใหม่ต้องรอตรวจสลิป ยอดต้องตรงราคาแผงจริง และต้องแนบสลิปในคำสั่งเขียนเดียวกัน
        && request.resource.data.status == 'pending'
        && request.resource.data.amountDue == getAfter(/databases/$(database)/documents/markets/main-layout/stalls/$(request.resource.data.stallId)).data.price
        && request.resource.data.createdAt == request.time
        && request.resource.data.slipUploadedAt == request.time
        && request.resource.data.slipHash is string
        && request.resource.data.keys().hasOnly(['stallId', 'stallNo', 'tenantId', 'customerName', 'customerPhone',
             'shopName', 'goodsType', 'amountDue', 'slipHash', 'slipUploadedAt', 'createdAt', 'status'])
        && existsAfter(/databases/$(database)/documents/bookingSlips/$(bookingId));
      // admin/owner ตัดสินได้เฉพาะ pending -> approved / needs_slip / rejected (และ needs_slip -> rejected)
      // แก้ได้แค่ฟิลด์ผลการตรวจ ห้ามแก้ยอด/ผู้เช่า/สลิป และสถานะแผงต้องเปลี่ยนตามผลในคำสั่งเดียวกัน
      allow update: if (isAdmin() && isValidDecision(bookingId))
        || isTenantResubmit(bookingId)
        || isTenantCancel();
      allow delete: if isAdmin();
    }

    // ─── Booking Slips (รูปสลิป แยกจาก bookings เพื่อไม่ให้รายการจองหนัก) ───────
    // อ่านได้เฉพาะเจ้าของและ admin; สร้างได้พร้อมการจองของตัวเองเท่านั้น; ลบ: admin
    match /bookingSlips/{bookingId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isNotAnonymous()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'marketId', 'dataUrl', 'mime', 'bytes', 'createdAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 750000
        && request.resource.data.dataUrl.matches('^data:image/(webp|jpeg);base64,.*')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.tenantId == request.auth.uid;
      // ส่งสลิปใหม่: เจ้าของแก้รูปได้เฉพาะตอน booking เป็น needs_slip และกลับเป็น pending ในคำสั่งเดียวกัน
      allow update: if isNotAnonymous()
        && resource.data.tenantId == request.auth.uid
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId', 'marketId', 'dataUrl', 'mime', 'bytes', 'createdAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 750000
        && request.resource.data.dataUrl.matches('^data:image/(webp|jpeg);base64,.*')
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'needs_slip'
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'pending';
      allow delete: if isAdmin();
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // สมัครได้เฉพาะ document ของตัวเอง และเป็น tenant เท่านั้น
      allow create: if isNotAnonymous()
        && request.auth.uid == userId
        && request.resource.data.role == 'tenant';

      // เจ้าของแก้ข้อมูลตัวเองได้ แต่ห้ามเปลี่ยน role / Owner เปลี่ยนได้ทุกอย่าง
      allow update: if isOwner()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role);

      allow delete: if isOwner();
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn()
        && (resource.data.tenantId == request.auth.uid || isAdmin());

      // ผู้เช่าทำได้แค่กด "อ่านแล้ว"
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.tenantId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));

      // แจ้งเตือนถูกสร้างตอน admin บันทึกผังเท่านั้น
      allow create: if isAdmin();
    }
  }
}
